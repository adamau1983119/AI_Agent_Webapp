{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    { "source": "/en/", "destination": "/en", "permanent": true },
    { "source": "/ja/", "destination": "/ja", "permanent": true }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/en.html" },
    { "source": "/ja", "destination": "/ja.html" },
    { "source": "/welcome", "destination": "/welcome.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/sitemap", "destination": "/sitemap.html" },
    {
      "source": "/((?!sitemap\\.xml$|robots\\.txt$|llms\\.txt$|logo\\.png$|favicon\\.png$|favicon\\.ico$|en\\.html$|ja\\.html$|welcome\\.html$|terms\\.html$|privacy\\.html$|sitemap\\.html$|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|llms\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}

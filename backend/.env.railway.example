# ============================================
# Railway 生產環境 — 複製到 Railway → Variables
# 金鑰請從本機 backend/.env 複製（勿提交 Git）
# ============================================

ENVIRONMENT=production
AUTO_START_SCHEDULER=true

# MongoDB Atlas
MONGODB_URL=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_agent_webapp

# AI
AI_SERVICE=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 圖片搜尋（必備 — 與 v6 本機相同）
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_cx_here

# 主題卡排程（v8 正式域）
ENABLE_SCHEDULED_TOPIC_COLLECTION=true
ENABLE_TOPIC_TRIPLE_PRELOAD=true
TOPIC_PIPELINE_VERSION=8

# JWT / OAuth
JWT_SECRET=your_long_random_jwt_secret_here
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.ai-alterego.com/api/v1/auth/google/callback

# URLs
BACKEND_URL=https://api.ai-alterego.com
FRONTEND_URL=https://ai-alterego.com
CORS_ORIGINS=["https://ai-alterego.com","https://www.ai-alterego.com"]

# Email（Resend）
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=Alter Ego <noreply@ai-alterego.com>

# Observability（可選）
OBS_WATCHDOG_ENABLED=true
OBS_DAILY_DIGEST_ENABLED=true

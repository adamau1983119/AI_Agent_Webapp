# ============================================
# Influencers AI Agents - 環境變數範本
# ============================================
# 複製為 .env 後填入實際值：cp .env.example .env
# 勿將 .env 提交至 Git
# ============================================

# ============================================
# 應用程式
# ============================================
APP_NAME=AI Agent Webapp
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============================================
# MongoDB
# ============================================
# 本機:
# MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_agent_webapp

# ============================================
# AI 服務
# ============================================
AI_SERVICE=deepseek

# DeepSeek（推薦）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# v7 D2：Flash／Pro 分離（generate/regenerate 用 PRO）
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_PRO_MAX_TOKENS=4096
# 向後相容；預設等同 FLASH
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Ollama 本機（可選）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# OpenAI / Gemini / Qwen（可選）
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# QWEN_API_KEY=

# ============================================
# v7 Token 省成本 — cost_controls（GET /health 可見）
# ============================================
# 開發／測試建議維持 false；詳見 docs/v7_token_cost_phase_checklist.md
AUTO_START_SCHEDULER=false
ENABLE_SCHEDULED_TOPIC_COLLECTION=false
ENABLE_AI_TOPIC_TRANSLATION=false
ENABLE_AI_TOPIC_FALLBACK=false
ENABLE_CHANNEL_PREFETCH_PIPELINE=false
# v8：產卡後批次 DeepL en/ja（預設關；勿與 ENABLE_AI_TOPIC_TRANSLATION 同開）
ENABLE_TOPIC_TRIPLE_PRELOAD=false
TOPIC_TRIPLE_PRELOAD_CAP=30

# ============================================
# v7 翻譯 — DeepL standard（卡片／夜間預載）
# ============================================
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
TRANSLATION_TIMEOUT_SEC=5

# ============================================
# Discover SKU — 公共主題牆（8h 批次 · PF-1）
# ============================================
ENABLE_PUBLIC_FEED_PIPELINE=false
# PUBLIC_FEED_BATCH_SIZE=30
# PUBLIC_FEED_INTERVAL_HOURS=8
# PUBLIC_FEED_WINDOW_HOURS=36
# PUBLIC_FEED_MAX_CARDS=135
# MAX_TRANSLATION_RETRIES=3

# ============================================
# 圖片搜尋 — Google Custom Search（相片搜尋必備）
# ============================================
# v6 本機測試用這組；正式站 Railway 也必須設相同兩個變數
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_cx_here

# 可選備援圖庫（非必須）
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ============================================
# 安全與 CORS
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# 日誌
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# Resend API Key（正式域 HTTPS 寄信；貼上 re_ 開頭的 key）
# ============================================
# RESEND_API_KEY=re_...
# EMAIL_FROM=Alter Ego <noreply@ai-alterego.com>
# （網域未 Verified 前可用：Alter Ego <onboarding@resend.dev>）
# GMAIL_USER=...
# GMAIL_APP_PASSWORD=...
# OBS_OPS_EMAIL=your_ops_inbox@gmail.com

# ============================================
# 注意事項
# ============================================
# 1. 本檔可提交 Git；實際金鑰僅放 .env
# 2. 生產環境請輪換 API Key
# 3. v7 驗證：curl http://localhost:8000/health 檢查 cost_controls 與 env 一致
# 4. Railway Hobby 擋 SMTP → 正式域必須設 RESEND_API_KEY

# ============================================
# Influencers AI Agents - 環境變數範本
# ============================================
# 複製為 .env 後填入實際值：cp .env.example .env
# 勿將 .env 提交至 Git
# ============================================

# ============================================
# 應用程式
# ============================================
APP_NAME=AI Agent Webapp
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============================================
# MongoDB
# ============================================
# 本機:
# MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_agent_webapp

# ============================================
# AI 服務
# ============================================
AI_SERVICE=deepseek

# DeepSeek（推薦）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# v7 D2：Flash／Pro 分離（generate/regenerate 用 PRO）
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_PRO_MAX_TOKENS=4096
# 向後相容；預設等同 FLASH
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Ollama 本機（可選）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# OpenAI / Gemini / Qwen（可選）
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# QWEN_API_KEY=

# ============================================
# v7 Token 省成本 — cost_controls（GET /health 可見）
# ============================================
# 開發／測試建議維持 false；詳見 docs/v7_token_cost_phase_checklist.md
AUTO_START_SCHEDULER=false
ENABLE_SCHEDULED_TOPIC_COLLECTION=false
ENABLE_AI_TOPIC_TRANSLATION=false
ENABLE_AI_TOPIC_FALLBACK=false
ENABLE_CHANNEL_PREFETCH_PIPELINE=false

# ============================================
# v7 翻譯 — DeepL standard（卡片／夜間預載）
# ============================================
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
TRANSLATION_TIMEOUT_SEC=5
# 收集時一次預寫主題卡三語（titles + descriptions）；預設 true
ENABLE_TOPIC_I18N_PREFETCH=true

# ============================================
# Discover SKU — 公共主題牆（8h 批次 · PF-1）
# ============================================
ENABLE_PUBLIC_FEED_PIPELINE=false
# PUBLIC_FEED_BATCH_SIZE=30
# PUBLIC_FEED_INTERVAL_HOURS=8
# PUBLIC_FEED_WINDOW_HOURS=36
# PUBLIC_FEED_MAX_CARDS=135
# MAX_TRANSLATION_RETRIES=3

# ============================================
# 圖片搜尋（可選）
# ============================================
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ============================================
# 安全與 CORS
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# 日誌
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# v8 Observability — 每日營運報告／Watchdog
# 正式域（Railway）必須設為 true，否則 loop 不啟動、不會自動寄信
# ============================================
OBS_WATCHDOG_ENABLED=true
OBS_DAILY_DIGEST_ENABLED=true
OBS_DAILY_DIGEST_HOUR_HKT=8
OBS_ALERTING_ENABLED=true
OBS_ALERT_EMAIL_SEND=true
OBS_ALERT_ONLY_ON_RED=true
OBS_ALERT_CRASH=true
OBS_ALERT_COST=true
OBS_WATCHDOG_INTERVAL_SEC=300
OBS_ALERT_COOLDOWN_SEC=3600
OBS_OPS_EMAIL=your_ops_inbox@gmail.com
# 寄信另需 Gmail（勿提交真實密碼）：
# GMAIL_USER=...
# GMAIL_APP_PASSWORD=...
# Railway Hobby 擋 SMTP → 日報改由 GitHub Actions「Obs Daily Digest」寄
#（repo Secrets 同名三鍵；workflow_dispatch 可手動試寄）

# ============================================
# 注意事項
# ============================================
# 1. 本檔可提交 Git；實際金鑰僅放 .env
# 2. 生產環境請輪換 API Key
# 3. v7 驗證：curl http://localhost:8000/health 檢查 cost_controls 與 env 一致
# 4. OBS：正式域未開 OBS_* → digest_enabled=false、無自動日報（營運失敗）
